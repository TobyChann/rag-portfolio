# Copy to ../.env on the server (next to docker-compose.prod.yml).
# Compose variables only; app settings live in backend/.env.

# Public hostname of the backend (your DuckDNS subdomain). Vercel's BACKEND_URL
# is https://<this>.
API_DOMAIN=toby-api.duckdns.org

# Password for the production Postgres container. Generate one with:
#   openssl rand -hex 24
POSTGRES_PASSWORD=
